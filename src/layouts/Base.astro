---
/**
 * Base layout: meta, OG, fonts, brand tokens, grain, JSON-LD slot.
 * Fonts: swap the three @fontsource-variable imports below if brand.ts names other fonts.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import displayFont from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import Grain from '../components/Grain.astro';
import { brand, siteUrl } from '../config/brand';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path = '/', noindex = false } = Astro.props;
const canonical = new URL(path, siteUrl).toString();
const ogImage = new URL('/og.jpg', siteUrl).toString();

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

const face = (family: string, url: string, weight: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${url}) format('woff2-variations'),url(${url}) format('woff2');unicode-range:${LATIN}}`;

const headCss = [
  face(brand.FONT_DISPLAY, displayFont, '200 900'),
  face(brand.FONT_BODY, bodyFont, '200 800'),
  face(brand.FONT_MONO, monoFont, '100 800'),
  `:root{--brand-bg:${brand.COLOR_BG};--brand-accent:${brand.COLOR_ACCENT};--brand-gold:${brand.COLOR_HIGHLIGHT};--brand-font-display:'${brand.FONT_DISPLAY}';--brand-font-body:'${brand.FONT_BODY}';--brand-font-mono:'${brand.FONT_MONO}'}`,
].join('');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={brand.COLOR_BG} />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.BRAND_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <Fragment set:html={`<style>${headCss}</style>`} />
    <script is:inline>
      (function (d) {
        d.classList.add('js');
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('static-theater');
      })(document.documentElement);
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#packages">Skip to packages</a>
    <slot />
    <Grain />
  </body>
</html>
