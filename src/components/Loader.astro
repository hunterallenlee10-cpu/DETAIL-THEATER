---
import { copy } from '../config/copy';
import { logoMarkSvg } from '../lib/logo-mark';
---

<div class="loader" role="status" aria-live="polite" aria-label="Loading">
  <div class="loader-inner">
    <span class="loader-mark" set:html={logoMarkSvg('currentColor', { id: 'ld', size: 56 })} />
    <span class="mono loader-label">{copy.loader.label} · <span class="pct">0</span>%</span>
    <span class="loader-line"><span></span></span>
  </div>
</div>

<script>
  const el = document.querySelector<HTMLElement>('.loader');
  if (el) {
    const pct = el.querySelector('.pct')!;
    const bar = el.querySelector<HTMLElement>('.loader-line span')!;
    let seen = false;
    try {
      seen = sessionStorage.getItem('seenLoader') === '1';
      sessionStorage.setItem('seenLoader', '1');
    } catch {}
    const MAX = seen ? 600 : 2500;
    const MIN = seen ? 150 : 450;
    const t0 = performance.now();
    let done = false;

    const set = (v: number) => {
      const n = Math.round(Math.max(0, Math.min(1, v)) * 100);
      pct.textContent = String(n);
      bar.style.transform = `scaleX(${n / 100})`;
    };

    const leave = () => {
      if (done) return;
      done = true;
      set(1);
      window.dispatchEvent(new CustomEvent('loader:leaving'));
      el.classList.add('is-leaving');
      const finish = () => {
        el.hidden = true;
        document.documentElement.dataset.loaderDone = '1';
        window.dispatchEvent(new CustomEvent('loader:done'));
      };
      // the hero reveal starts while the loader fades
      setTimeout(finish, seen ? 250 : 420);
    };

    const ready = () => {
      const wait = Math.max(0, MIN - (performance.now() - t0));
      setTimeout(leave, wait);
    };

    window.addEventListener('theater:progress', (e) => {
      const { done: d, total } = (e as CustomEvent<{ done: number; total: number }>).detail;
      set(d / total);
    });
    window.addEventListener('theater:ready', ready, { once: true });
    setTimeout(leave, MAX);
  }
</script>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: var(--bg);
    transition:
      opacity 0.6s var(--ease-out),
      visibility 0s linear 0.6s;
    /* failsafe: never trap the user, even if JS dies */
    animation: loader-failsafe 0.5s 4s forwards;
  }

  :global(html:not(.js)) .loader {
    display: none;
  }

  .loader-inner {
    display: grid;
    justify-items: center;
    gap: 18px;
    transition: transform 0.6s var(--ease-out);
  }

  .loader-mark {
    color: var(--accent);
  }

  .loader-label {
    color: var(--muted);
    font-size: 10.5px;
  }

  .loader-line {
    position: relative;
    width: 180px;
    height: 1px;
    background: var(--line);
    overflow: hidden;
  }

  .loader-line span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .loader.is-leaving {
    opacity: 0;
    visibility: hidden;
  }

  .loader.is-leaving .loader-inner {
    transform: scale(0.96);
  }

  @keyframes loader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
