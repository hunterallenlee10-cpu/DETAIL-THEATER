---
// Fixed film-grain overlay: a tiled SVG feTurbulence tile, rasterized once by the browser.
const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .5  0 0 0 0 .5  0 0 0 0 .5  0 0 0 1.4 -.2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>`;
const url = `url("data:image/svg+xml;utf8,${svg.replace(/"/g, "'").replace(/</g, '%3C').replace(/>/g, '%3E')}")`;
---

<div class="grain" aria-hidden="true" style={`--grain:${url}`}></div>

<style>
  .grain {
    position: fixed;
    inset: 0;
    z-index: 900;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 220px 220px;
    opacity: 0.06;
    mix-blend-mode: overlay;
  }
</style>
